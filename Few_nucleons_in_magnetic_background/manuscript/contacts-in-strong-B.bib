@article{AMADO197125,
title = "On Efimov's effect: A new pathology of three-particle systems",
journal = "Physics Letters B",
volume = "35",
number = "1",
pages = "25 - 27",
year = "1971",
issn = "0370-2693",
doi = "https://doi.org/10.1016/0370-2693(71)90429-1",
url = "http://www.sciencedirect.com/science/article/pii/0370269371904291",
author = "R.D. Amado and J.V. Noble",
abstract = "We prove rigorously that the number of bound states of a three-body system grows according to the formula N ∼ 1/π ln(|a|/R) when the ratio of scattering lengths, α, to the range, R, of two-body forces is large, in agreement with Efimov's recent claim. We discuss the meaning of this effect in terms of the behavior of the Faddeev equations describing the three-particle system, and clarify several points of Efimov's paper."
}
