 &fbsinp
  npar=3
!     masses
  xm(1)=1.  xm(2)=1. xm(3)=1.  
!     charges
  z(1)=0.  z(2)=0. z(3)=0.  
!
!     isospin configurations
  nisc=2
    cisc(1)= 1. iso(1,1)=2 iso(2,1)=1 iso(3,1)=2  
    cisc(2)=-1. iso(1,2)=2 iso(2,2)=2 iso(3,2)=1  
!
!     spin configurations
  nspc=2
    cspc(1)= 1. isp(1,1)=1 isp(2,1)=2 isp(3,1)=2  
    cspc(2)=-1. isp(1,2)=2 isp(2,2)=1 isp(3,2)=2  
!
    h2m=41.47
    irand=-1776 ico=1 ibf=1
    mm0=20  kk0=20  mnb=100
    bmin=0.01  bmax=20
!
!     selecting representation
  ipcon=2
!
  npt=1  nop=3
! Pionless EFT LO Potential
!
  vpot(1,1)=-124.3217     apot(1,1)=  1.0000  bpot(1,1)=0. npot(1,1)=0
  vpot(1,3)=-18.0423      apot(1,3)=  1.0000  bpot(1,3)=0. npot(1,3)=0 
!
! 3-body potential
