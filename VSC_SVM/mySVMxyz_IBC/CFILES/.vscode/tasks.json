{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++ build active file",
            "command": "/opt/intel/oneapi/compiler/2024.1/bin/icpx",
            "args": [
                "-g",
                "${file}",
                "${fileDirname}/SVM.cpp",
                "${fileDirname}/MatrixElement.cpp",
                "${fileDirname}/Input.cpp",
                "${fileDirname}/Operators.cpp",
                "${fileDirname}/Rand.cpp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-I",
                "/home/kirscher/kette_repo/SVMmagnetic/VSC_SVM/mySVMxyz_IBC/eigen/Eigen"
            ],
            "options": {
                "cwd": "/usr/bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc-8 build active file",
            "command": "/opt/intel/oneapi/compiler/2024.1/bin/icpx",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                //"${file}",
                "${fileDirname}/*.cpp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-I",
                "/usr/include/eigen3/Eigen"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
    }