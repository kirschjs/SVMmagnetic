Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"particles", "=", "2"}], ";"}], "  "}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dimensions", "=", "2"}], ";"}], "  ", 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FindRearrangements", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "allCombinations", ",", "rearrangements", ",", 
        "uniqueRearrangements"}], "}"}], ",", 
      RowBox[{
       RowBox[{"allCombinations", "=", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "n"}], "]"}], ",", 
          RowBox[{"dimensions", "*", "particles"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"rearrangements", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{"#", ",", "dimensions"}], "]"}], "&"}], "/@", 
           "allCombinations"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", 
             RowBox[{"Flatten", "[", "#", "]"}], "]"}], "==", "n"}], "&"}]}], 
         "  ", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uniqueRearrangements", "=", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Sort", "/@", "rearrangements"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Total unique rearrangements: \>\"", ",", 
         RowBox[{"Length", "[", "uniqueRearrangements", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Rearrangements:\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"StringJoin", "[", 
           RowBox[{"Riffle", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\"\<(\>\"", "<>", 
                RowBox[{"StringJoin", "[", 
                 RowBox[{"Riffle", "[", 
                  RowBox[{
                   RowBox[{"ToString", "/@", 
                    RowBox[{"uniqueRearrangements", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "p"}], "]"}], "]"}]}], ",", 
                   "\"\<,\>\""}], "]"}], "]"}], "<>", "\"\<)\>\""}], ",", 
               RowBox[{"{", 
                RowBox[{"p", ",", "particles"}], "}"}]}], "]"}], ",", 
             "\"\< \>\""}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "uniqueRearrangements", "]"}]}], "}"}]}], 
        "]"}], ";"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"n", "=", "3"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindRearrangements", "[", "n", "]"}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.946452986155471*^9, 3.946453055478436*^9}, {
  3.946523576536603*^9, 3.9465236493357983`*^9}, {3.946523689765869*^9, 
