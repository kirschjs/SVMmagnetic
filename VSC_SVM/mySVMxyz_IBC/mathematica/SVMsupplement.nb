Cell[TextData[{
 "So from this we infer that ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     RowBox[{"det", "(", GridBox[{
        {
         SubscriptBox["E", "1"], "\[Placeholder]", "\[Placeholder]", 
         SubscriptBox["q", "1"]},
        {"\[Placeholder]", "\[DescendingEllipsis]", "\[Placeholder]", 
         "\[VerticalEllipsis]"},
        {"\[Placeholder]", "\[Placeholder]", 
         SubscriptBox["E", 
          RowBox[{"N", "-", "1"}]], 
         SubscriptBox["q", 
          RowBox[{"N", "-", "1"}]]},
        {
         SubscriptBox["q", "1"], "\[Ellipsis]", 
         SubscriptBox["q", 
          RowBox[{"N", "-", "1"}]], "a"}
       }], ")"}], "=", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        UnderoverscriptBox["\[Sum]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"N", "-", "1"}]], 
        RowBox[{
         SubsuperscriptBox["q", "i", "2"], 
         RowBox[{
          SubscriptBox["\[Product]", 
           RowBox[{"j", "\[NotEqual]", "i"}]], 
          RowBox[{"(", 
           RowBox[{"\[Lambda]", "-", 
            SubscriptBox["E", "j"]}], ")"}]}]}]}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Lambda]", "-", "a"}], ")"}], 
       RowBox[{
        SubsuperscriptBox["\[Product]", 
         RowBox[{"i", "=", "1"}], 
         RowBox[{"N", "-", "1"}]], 
        RowBox[{"(", 
         RowBox[{"\[Lambda]", "-", 
          SubscriptBox["E", "j"]}], ")"}]}]}]}]}]}], TraditionalForm]],
  InitializationCell->True,
  FormatType->TraditionalForm,ExpressionUUID->
  "df61c35f-0613-41a0-809a-153077b9380e"],
 " which matches Eq.(15) in https://inspirehep.net/literature/398252"
}], "Text",
